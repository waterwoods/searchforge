# Dockerfile for GCP Cloud Run deployment
# This Dockerfile is optimized for Cloud Run:
# - Uses port 8080 (Cloud Run default)
# - Stateless container design
# - Minimal dependencies for production

FROM python:3.11-slim

# Injected at build time (Cloud Build / deploy_rag_demo.sh) so /version can report deploy identity.
ARG GIT_SHA=
ENV GIT_SHA=${GIT_SHA}

# Set working directory
WORKDIR /app

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PORT=8080 \
    PIP_NO_CACHE_DIR=1

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copy dependency files first (for better layer caching)
COPY requirements.txt /app/requirements.txt

# Install Python dependencies
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt && \
    python -c "import psycopg; print('✅ psycopg import OK (dual-write)')"

# Keep image build deterministic for paid-pilot intake deploys:
# do not pre-download embedding models in Cloud Build.

# Copy the rest of the application code
# Note: We copy from repo root to maintain module structure
# First copy services/__init__.py to make services a package
COPY services/__init__.py /app/services/__init__.py
# Copy services/fiqa_api/ including all subdirectories (models, routes, etc.)
COPY services/fiqa_api/ /app/services/fiqa_api/
COPY services/core/ /app/services/core/
COPY services/plugins/ /app/services/plugins/
COPY services/api/ /app/services/api/
COPY services/routers/ /app/services/routers/
COPY services/autotuner_router.py /app/services/autotuner_router.py
COPY services/code_intelligence/ /app/services/code_intelligence/
COPY services/black_swan/ /app/services/black_swan/
COPY modules/ /app/modules/
COPY engines/ /app/engines/
COPY interfaces/ /app/interfaces/
COPY agents/ /app/agents/
COPY routes/ /app/routes/
COPY orchestrators/ /app/orchestrators/
COPY tools/ /app/tools/
COPY experiments/ /app/experiments/
COPY configs/ /app/configs/

# Set PYTHONPATH to include /app
ENV PYTHONPATH=/app:${PYTHONPATH}

# Smoke test: verify critical imports work before deployment
# Intentionally import fiqa_api.models — must not be excluded from Cloud Build context (see .gitignore /models/).
RUN python -c "import sys; sys.path.insert(0, '/app'); import services.fiqa_api.models.experiment_models; print('✅ Import smoke test passed')" || \
    (echo "❌ Import smoke test failed - check package structure / build context" && \
     echo "Debug: Checking structure..." && \
     ls -la /app/services/ && \
     ls -la /app/services/fiqa_api/ && \
     ls -la /app/services/fiqa_api/models/ && \
     exit 1)

# Expose port 8080 (Cloud Run default)
EXPOSE 8080

# Liveness: use /health/live (reaches the app on Cloud Run). Top-level /healthz is not
# reliably reachable through Google’s HTTP frontend for external checks; inside the container
# /health/live is the stable probe target (see docs/runbooks/KNOWN_DEPLOYMENT_GOTCHAS.md).
HEALTHCHECK --interval=30s --timeout=3s --start-period=40s --retries=3 \
    CMD curl -f http://127.0.0.1:${PORT}/health/live || exit 1

# Run uvicorn with the app
# Cloud Run sets PORT env var automatically, we use it here
CMD ["sh", "-c", "python -m uvicorn services.fiqa_api.app_main:app --host 0.0.0.0 --port ${PORT:-8080}"]

