    "ignore": ["README.md", "tests/**", "config.example.ts"]
  },
  "setting": {
    "urlCheck": false,
    "es6": true,
    "enhance": true,
    "postcss": true,
    "minified": false,
    "newFeature": true,
    "coverView": true,
