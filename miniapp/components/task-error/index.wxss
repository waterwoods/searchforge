.task-error {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 28rpx;
  border-radius: 16rpx;
  background: #fff6f5;
  border: 1rpx solid #ffd7d3;
}

.message {
  color: #7b341e;
  font-size: 28rpx;
  line-height: 1.5;
}

.btn-retry,
.btn-contact {
  font-size: 28rpx;
  border-radius: 12rpx;
}

.btn-retry {
  background: #2251cc;
  color: #ffffff;
}

.btn-contact {
  background: #ffffff;
  color: #2251cc;
  border: 1rpx solid #2251cc;
}
