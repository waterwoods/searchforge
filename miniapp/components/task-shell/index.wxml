<view class="task-shell">
  <task-loading wx:if="{{mode === 'loading'}}" message="{{safeLoadingMessage}}" />

  <task-error
    wx:elif="{{mode === 'blocking_error'}}"
    message="{{safeError.message}}"
    retryable="{{safeError.retryable}}"
    bind:retry="onRetry"
    bind:contactBroker="onContactBroker"
  />

  <view wx:else class="task-content">
    <slot />
  </view>

  <view wx:if="{{showFooter && safeSafetyCopy}}" class="task-footer">
    <text>{{safeSafetyCopy}}</text>
  </view>
</view>
