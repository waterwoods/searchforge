<view class="container">
  <view wx:if="{{loading}}" class="loading-wrap">
    <text class="loading-text">正在加载您的资料…</text>
  </view>

  <block wx:else>
    <view class="card">
      <view class="status-pill {{submitted ? 'done' : ''}}">{{status}}</view>
      <view class="card-title">{{title}}</view>
      <view class="card-subtitle">{{subtitle}}</view>

      <view class="progress-bar">
        <view class="progress-fill" style="width: {{progress}}%;"></view>
      </view>

      <view class="section-label">已收到</view>
      <view wx:if="{{received.length}}" class="received-list">
        <view class="received-item" wx:for="{{received}}" wx:key="*this">{{item}}</view>
      </view>
      <view wx:else class="received-item muted">暂无</view>

      <view class="section-label section-gap">还需补充</view>
      <view wx:if="{{supplementRows.length}}" class="task-row-list">
        <view
          wx:for="{{supplementRows}}"
          wx:key="key"
          class="task-row {{item.actionable ? 'actionable' : 'static'}}"
          hover-class="{{item.actionable ? 'task-row-hover' : ''}}"
          data-index="{{index}}"
          bindtap="onTapSupplementRow"
        >
          <view class="task-row-main">
            <text class="task-row-label">{{item.label}}</text>
            <text class="task-row-status {{item.actionable ? 'pending' : 'muted'}}">{{item.statusText}}</text>
          </view>
          <text wx:if="{{item.actionable}}" class="task-row-arrow">›</text>
          <text wx:elif="{{item.hint}}" class="task-row-hint">{{item.hint}}</text>
        </view>
      </view>
      <view wx:else class="received-item muted">主要资料已齐全</view>

      <view class="section-label section-gap">下一步</view>
      <view class="next-action-text">{{nextAction || '点击下方按钮继续'}}</view>
    </view>

    <view class="disclaimer" bindtap="onShowDisclaimer">{{disclaimer}}</view>
  </block>

  <view class="footer-cta" wx:if="{{!loading}}">
    <button
      class="btn-primary"
      hover-class="btn-primary-hover"
      bindtap="onPrimaryAction"
      loading="{{navigating}}"
      disabled="{{navigating}}"
    >{{primaryCta}}</button>
    <button class="btn-secondary" hover-class="btn-secondary-hover" bindtap="onViewAll">查看全部资料</button>
  </view>
</view>
