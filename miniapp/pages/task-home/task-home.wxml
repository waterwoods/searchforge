<view class="container task-home-page">
  <task-shell
    loading="{{busy.loading}}"
    error="{{errorState}}"
    loadingMessage="{{loadingMessage}}"
    safetyCopy="{{shellSafetyCopy}}"
    showFooter="{{true}}"
    bind:retry="onRetry"
    bind:contactBroker="onContactBroker"
  >
    <task-error
      wx:if="{{errorState.message && !errorState.blocking}}"
      message="{{errorState.message}}"
      retryable="{{errorState.retryable}}"
      retryDisabled="{{busy.retrying}}"
      bind:retry="onRetry"
      bind:contactBroker="onContactBroker"
    />

    <view class="card" wx:if="{{slice1Enabled}}">
      <view class="card-title">{{taskViewModel.title}}</view>
      <task-progress
        completed="{{taskViewModel.progress.completed}}"
        total="{{taskViewModel.progress.total}}"
      />
      <view class="status-pill {{slice1WaitingForBroker ? 'done' : ''}}">
        {{slice1WaitingForBroker ? '等待审核' : '需补充'}}
      </view>
      <view class="card-subtitle">{{slice1Instruction || taskViewModel.instruction || '请按陈总要求补充资料'}}</view>
      <view class="list-item" wx:if="{{slice1ProgressText}}">{{slice1ProgressText}}</view>
      <view class="list-item" wx:if="{{slice1BrokerStatusLabel}}">经纪人状态：{{slice1BrokerStatusLabel}}</view>
      <view class="section-label" wx:if="{{slice1QueuedItems.length}}">稍后还需补充</view>
      <view
        class="list-item"
        wx:for="{{slice1QueuedItems}}"
        wx:key="request_item_id"
      >{{item.position}}. {{item.label}}</view>
      <view class="section-label" wx:if="{{slice1SatisfiedItems.length}}">已完成</view>
      <view
        class="list-item"
        wx:for="{{slice1SatisfiedItems}}"
        wx:key="request_item_id"
      >{{item.label}} · 已提交</view>
    </view>

    <view class="card" wx:else>
      <view class="card-title">{{taskViewModel.title}}</view>
      <task-progress
        completed="{{taskViewModel.progress.completed}}"
        total="{{taskViewModel.progress.total}}"
      />
      <task-status-card
        status="{{taskViewModel.statusLabel}}"
        statusTone="{{taskViewModel.statusTone}}"
        instruction="{{taskViewModel.instruction}}"
        received="{{task && task.dashboard_summary && task.dashboard_summary.received ? task.dashboard_summary.received : []}}"
        missing="{{taskViewModel.missingItems}}"
        nextActionText="{{taskViewModel.instruction || '点击下方按钮继续'}}"
        bind:tapmissing="onTapSupplementRow"
      />
    </view>

    <view class="disclaimer" bindtap="onShowDisclaimer">{{taskViewModel.safetyCopy}}</view>
  </task-shell>

  <view class="footer-cta" wx:if="{{!busy.loading}}">
    <task-cta
      label="{{slice1Enabled ? slice1PrimaryLabel : (task && (task.submitted || task.current_step === 'done') ? '补充或修改资料' : taskViewModel.cta.label)}}"
      disabled="{{slice1Enabled ? (slice1WaitingForBroker || busy.navigating || busy.submitting) : (task && (task.submitted || task.current_step === 'done') ? (busy.navigating || busy.submitting) : taskViewModel.cta.disabled)}}"
      loading="{{busy.navigating || busy.submitting}}"
      disabledReason="{{slice1Enabled && slice1WaitingForBroker ? '资料已提交，等待经纪人审核' : ctaDisabledReason}}"
      bindtap="onPrimaryAction"
    />
    <button
      wx:if="{{slice1Enabled && slice1WaitingForBroker}}"
      class="btn-secondary"
      hover-class="btn-secondary-hover"
      bindtap="onViewReceipt"
      disabled="{{busy.navigating || busy.submitting}}"
    >查看提交结果</button>
    <button
      wx:if="{{!slice1Enabled && task && (task.submitted || task.current_step === 'done')}}"
      class="btn-secondary"
      hover-class="btn-secondary-hover"
      bindtap="onViewReceipt"
      disabled="{{busy.navigating || busy.submitting}}"
    >查看提交结果</button>
    <button
      wx:if="{{!(slice1Enabled && slice1WaitingForBroker) && !(task && (task.submitted || task.current_step === 'done'))}}"
      class="btn-secondary"
      hover-class="btn-secondary-hover"
      bindtap="onViewAll"
    >查看全部资料</button>
  </view>
</view>
