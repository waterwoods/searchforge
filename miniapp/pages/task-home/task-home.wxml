<view class="container task-home-page">
  <task-shell
    loading="{{busy.loading}}"
    error="{{errorState}}"
    loadingMessage="{{loadingMessage}}"
    safetyCopy="{{shellSafetyCopy}}"
    showFooter="{{true}}"
    bind:retry="onRetry"
    bind:contactBroker="onContactBroker"
  >
    <task-error
      wx:if="{{errorState.message && !errorState.blocking}}"
      message="{{errorState.message}}"
      retryable="{{errorState.retryable}}"
      retryDisabled="{{busy.retrying}}"
      bind:retry="onRetry"
      bind:contactBroker="onContactBroker"
    />

    <view class="card">
      <view class="status-pill {{taskViewModel.statusTone === 'done' ? 'done' : ''}}">{{taskViewModel.statusLabel}}</view>
      <view class="card-title">{{taskViewModel.title}}</view>
      <view class="card-subtitle">{{taskViewModel.instruction}}</view>

      <view class="progress-bar">
        <view class="progress-fill" style="width: {{taskViewModel.progress.percent}}%;"></view>
      </view>
      <view class="progress-text">{{taskViewModel.progress.completed}} / {{taskViewModel.progress.total}}</view>

      <view class="section-label">已收到</view>
      <view wx:if="{{task && task.dashboard_summary && task.dashboard_summary.received.length}}" class="received-list">
        <view class="received-item" wx:for="{{task.dashboard_summary.received}}" wx:key="*this">{{item}}</view>
      </view>
      <view wx:else class="received-item muted">暂无</view>

      <view class="section-label section-gap">还需补充</view>
      <view wx:if="{{taskViewModel.missingItems.length}}" class="task-row-list">
        <view
          wx:for="{{taskViewModel.missingItems}}"
          wx:key="key"
          class="task-row {{item.actionable ? 'actionable' : 'static'}}"
          hover-class="{{item.actionable ? 'task-row-hover' : ''}}"
          data-index="{{index}}"
          bindtap="onTapSupplementRow"
        >
          <view class="task-row-main">
            <text class="task-row-label">{{item.label}}</text>
            <text class="task-row-status {{item.actionable ? 'pending' : 'muted'}}">{{item.statusText}}</text>
          </view>
          <text wx:if="{{item.actionable}}" class="task-row-arrow">›</text>
          <text wx:elif="{{item.hint}}" class="task-row-hint">{{item.hint}}</text>
        </view>
      </view>
      <view wx:else class="received-item muted">主要资料已齐全</view>

      <view class="section-label section-gap">下一步</view>
      <view class="next-action-text">{{taskViewModel.instruction || '点击下方按钮继续'}}</view>
    </view>

    <view class="disclaimer" bindtap="onShowDisclaimer">{{taskViewModel.safetyCopy}}</view>
  </task-shell>

  <view class="footer-cta" wx:if="{{!busy.loading}}">
    <task-cta
      label="{{taskViewModel.cta.label}}"
      disabled="{{taskViewModel.cta.disabled}}"
      loading="{{taskViewModel.cta.loading || busy.navigating}}"
      disabledReason="{{ctaDisabledReason}}"
      bindtap="onPrimaryAction"
    />
    <button class="btn-secondary" hover-class="btn-secondary-hover" bindtap="onViewAll">查看全部资料</button>
  </view>
</view>
