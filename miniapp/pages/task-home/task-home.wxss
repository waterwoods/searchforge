.section-gap {
  margin-top: 28rpx;
}

.received-list {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.received-item {
  font-size: 28rpx;
  color: #333333;
  line-height: 1.5;
}

.received-item.muted {
  color: #888888;
}

.next-action-text {
  font-size: 28rpx;
  color: #444444;
  line-height: 1.5;
}

.task-row-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.task-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 96rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: #f8f9fb;
  box-sizing: border-box;
}

.task-row.actionable {
  background: #ffffff;
  border: 2rpx solid #e4e8ee;
}

.task-row.static {
  background: #f3f4f6;
}

.task-row-hover {
  background: #eef3fc !important;
  border-color: #c5d5f5 !important;
}

.task-row-main {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-width: 0;
}

.task-row-label {
  font-size: 30rpx;
  color: #1a1a1a;
  font-weight: 500;
  flex-shrink: 0;
}

.task-row-status {
  font-size: 26rpx;
  text-align: right;
  flex: 1;
  min-width: 0;
}

.task-row-status.pending {
  color: #c45c26;
}

.task-row-status.muted {
  color: #888888;
}

.task-row-arrow {
  margin-left: 12rpx;
  font-size: 40rpx;
  line-height: 1;
  color: #9aa0a6;
  font-weight: 300;
}

.task-row-hint {
  margin-left: 12rpx;
  font-size: 22rpx;
  color: #888888;
  max-width: 200rpx;
  text-align: right;
  line-height: 1.3;
}
