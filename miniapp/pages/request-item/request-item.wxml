<view class="container request-item-page">
  <task-shell
    loading="{{loading}}"
    error="{{pageError}}"
    loadingMessage="{{loadingMessage}}"
    safetyCopy="{{shellSafetyCopy}}"
    showFooter="{{true}}"
    bind:retry="onRetry"
    bind:contactBroker="onContactBroker"
  >
    <task-error
      wx:if="{{pageError.message && !pageError.blocking}}"
      message="{{pageError.message}}"
      retryable="{{pageError.retryable}}"
      retryDisabled="{{busy.retrying || busy.submitting}}"
      bind:retry="onRetry"
      bind:contactBroker="onContactBroker"
    />

    <view class="card submit-receipt" wx:if="{{submitReceiptVisible}}">
      <view class="status-pill done">已收到</view>
      <view class="card-title">{{submitReceiptText}}</view>
    </view>

    <view class="card" wx:if="{{waitingForBroker && !submitReceiptVisible}}">
      <view class="status-pill done">已收到</view>
      <view class="card-title">{{nextActionTitle || '资料已收到，等待陈总审核'}}</view>
      <view class="card-subtitle">{{nextActionInstructions || '陈总已收到您的补充资料，正在审核。'}}</view>
      <task-progress completed="{{progress.satisfied}}" total="{{progress.total || 1}}" />
      <view class="meta-line" wx:if="{{lastServerUpdate}}">进度已更新</view>
    </view>

    <!-- P26H-UI: bind showWorkSurface — never nextAction alone (system_default has null nextAction). -->
    <block wx:elif="{{showWorkSurface}}">
      <view class="card">
        <view class="status-pill">需补充材料</view>
        <view class="card-title">{{nextActionTitle}}</view>
        <view class="card-subtitle">{{nextActionInstructions}}</view>
        <task-progress completed="{{progress.satisfied}}" total="{{progress.total || 1}}" />
        <view class="meta-line" wx:if="{{progress.total}}">进度 {{progress.satisfied}}/{{progress.total}}</view>
        <view class="meta-line" wx:if="{{brokerStatusLabel}}">经纪人状态：{{brokerStatusLabel}}</view>
        <view class="meta-line" wx:if="{{lastServerUpdate}}">进度已更新</view>
      </view>

      <view class="card correction-card" wx:if="{{needsCorrection}}">
        <view class="correction-text">这些信息需要修改，请检查后重新提交</view>
      </view>

      <view class="card" wx:if="{{inputMode === 'text'}}">
        <view class="section-label">{{inputLabel}}</view>
        <textarea
          wx:if="{{itemType === 'free_text'}}"
          class="textarea-field"
          placeholder="{{inputPlaceholder}}"
          maxlength="2000"
          value="{{draftValue}}"
          bindinput="onDraftInput"
          auto-height
          show-confirm-bar="{{false}}"
          disabled="{{busy.submitting}}"
        />
        <input
          wx:else
          class="text-field"
          type="text"
          maxlength="17"
          placeholder="{{inputPlaceholder}}"
          value="{{draftValue}}"
          bindinput="onDraftInput"
          disabled="{{busy.submitting}}"
        />
        <view class="field-error" wx:if="{{validationMessage}}">{{validationMessage}}</view>
      </view>

      <!-- Claim Vehicle / 事故车辆 — structured vehicle_information form -->
      <view class="card" wx:if="{{inputMode === 'vehicle'}}">
        <view class="section-label">车辆识别码（VIN）</view>
        <input
          class="text-field {{fieldErrors.vin ? 'field-invalid' : ''}}"
          type="text"
          maxlength="17"
          placeholder="请输入 17 位 VIN"
          value="{{vehicleForm.vin}}"
          data-field="vin"
          bindinput="onVehicleFieldInput"
          disabled="{{busy.submitting || vehicleForm.vinUnavailable}}"
        />
        <view class="field-error" wx:if="{{fieldErrors.vin}}">{{fieldErrors.vin}}</view>

        <label class="vin-unavailable-row">
          <switch
            checked="{{vehicleForm.vinUnavailable}}"
            bindchange="onVinUnavailableChange"
            disabled="{{busy.submitting}}"
            color="#1d4ed8"
          />
          <text class="vin-unavailable-label">暂时无法提供 VIN</text>
        </label>

        <!-- Year/make/model always visible for resume; required only when VIN unavailable. -->
        <view class="ymm-block {{vehicleForm.vinUnavailable ? 'ymm-required' : 'ymm-secondary'}}">
          <view class="section-label section-gap">年份</view>
          <input
            class="text-field {{fieldErrors.year ? 'field-invalid' : ''}}"
            type="number"
            maxlength="4"
            placeholder="例如 2020"
            value="{{vehicleForm.year}}"
            data-field="year"
            bindinput="onVehicleFieldInput"
            disabled="{{busy.submitting}}"
          />
          <view class="field-error" wx:if="{{fieldErrors.year}}">{{fieldErrors.year}}</view>

          <view class="section-label section-gap">品牌</view>
          <input
            class="text-field {{fieldErrors.make ? 'field-invalid' : ''}}"
            type="text"
            maxlength="40"
            placeholder="例如 Toyota"
            value="{{vehicleForm.make}}"
            data-field="make"
            bindinput="onVehicleFieldInput"
            disabled="{{busy.submitting}}"
          />
          <view class="field-error" wx:if="{{fieldErrors.make}}">{{fieldErrors.make}}</view>

          <view class="section-label section-gap">型号</view>
          <input
            class="text-field {{fieldErrors.model ? 'field-invalid' : ''}}"
            type="text"
            maxlength="40"
            placeholder="例如 Camry"
            value="{{vehicleForm.model}}"
            data-field="model"
            bindinput="onVehicleFieldInput"
            disabled="{{busy.submitting}}"
          />
          <view class="field-error" wx:if="{{fieldErrors.model}}">{{fieldErrors.model}}</view>
        </view>

        <view class="optional-block">
          <view class="section-label section-gap optional-label">车牌号（选填）</view>
          <input
            class="text-field text-field-secondary"
            type="text"
            maxlength="12"
            placeholder="选填"
            value="{{vehicleForm.licensePlate}}"
            data-field="licensePlate"
            bindinput="onVehicleFieldInput"
            disabled="{{busy.submitting}}"
          />

          <view class="section-label section-gap optional-label">车牌州（选填）</view>
          <input
            class="text-field text-field-secondary"
            type="text"
            maxlength="2"
            placeholder="例如 CA"
            value="{{vehicleForm.plateState}}"
            data-field="plateState"
            bindinput="onVehicleFieldInput"
            disabled="{{busy.submitting}}"
          />
        </view>

        <view class="field-error" wx:if="{{validationMessage && !fieldErrors.vin && !fieldErrors.year}}">{{validationMessage}}</view>
      </view>

      <view class="card" wx:if="{{inputMode === 'evidence'}}">
        <view class="section-label">上传资料</view>
        <view class="upload-stage upload-phase-{{uploadPhase}}" wx:if="{{uploadStatusText}}">
          {{uploadStatusText}}
        </view>
        <view class="preview-wrap" wx:if="{{uploadItems[0].localPath}}">
          <image
            class="preview-image"
            mode="aspectFill"
            src="{{uploadItems[0].localPath}}"
            bindtap="onPreviewUpload"
          />
          <view wx:if="{{uploadItems[0].uploading}}" class="preview-mask">
            上传中 {{uploadItems[0].progress}}%
          </view>
          <view
            wx:elif="{{uploadPhaseLabel}}"
            class="preview-badge phase-{{uploadPhase}}"
          >{{uploadPhaseLabel}}</view>
        </view>
        <button
          class="btn-secondary"
          hover-class="btn-secondary-hover"
          bindtap="onChoosePhoto"
          disabled="{{busy.submitting || uploadItems[0].uploading}}"
        >{{uploadItems[0].localPath ? '重新选择照片' : '选择照片'}}</button>
        <view class="field-error" wx:if="{{validationMessage}}">{{validationMessage}}</view>
      </view>

      <view class="card" wx:if="{{queuedItems.length}}">
        <view class="section-label">稍后还需补充</view>
        <view
          class="list-item"
          wx:for="{{queuedItems}}"
          wx:key="request_item_id"
        >{{item.position}}. {{item.label}}</view>
      </view>

      <view class="card" wx:if="{{satisfiedItems.length}}">
        <view class="section-label">已完成</view>
        <view
          class="list-item"
          wx:for="{{satisfiedItems}}"
          wx:key="request_item_id"
        >{{item.label}} · 已提交</view>
      </view>
    </block>
  </task-shell>

  <view class="footer-cta" wx:if="{{showFooterCta && !waitingForBroker}}">
    <task-cta
      label="{{submitLabel}}"
      disabled="{{submitDisabled || busy.submitting}}"
      loading="{{busy.submitting || uploadItems[0].uploading}}"
      disabledReason="{{submitDisabledReason}}"
      bindtap="onSubmit"
    />
    <button
      wx:if="{{retryAvailable}}"
      class="btn-secondary"
      hover-class="btn-secondary-hover"
      bindtap="onRetrySubmit"
      disabled="{{busy.submitting}}"
    >重试提交</button>
    <button
      class="btn-secondary"
      hover-class="btn-secondary-hover"
      bindtap="onLater"
      disabled="{{busy.submitting}}"
    >稍后再填</button>
  </view>

  <view class="footer-cta" wx:if="{{!loading && waitingForBroker}}">
    <task-cta
      label="查看案件状态"
      disabled="{{busy.navigating}}"
      loading="{{busy.navigating}}"
      bindtap="onBackHome"
    />
  </view>
</view>
