.request-item-page .text-field {
  width: 100%;
  min-height: 88rpx;
  padding: 20rpx 24rpx;
  border: 1rpx solid #d8dde6;
  border-radius: 12rpx;
  background: #fff;
  box-sizing: border-box;
}

.request-item-page .preview-image {
  width: 100%;
  height: 320rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  background: #eef1f5;
}

.request-item-page .meta-line {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #6b7280;
}

.request-item-page .upload-stage {
  margin-bottom: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: #eef4ff;
  color: #174ea6;
  font-size: 26rpx;
}

.footer-cta {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
