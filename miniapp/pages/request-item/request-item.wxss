.request-item-page .text-field {
  width: 100%;
  min-height: 88rpx;
  padding: 20rpx 24rpx;
  border: 1rpx solid #d8dde6;
  border-radius: 12rpx;
  background: #fff;
  box-sizing: border-box;
}

.request-item-page .preview-wrap {
  position: relative;
  width: 100%;
  height: 320rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  background: #eef1f5;
}

.request-item-page .preview-image {
  width: 100%;
  height: 100%;
  display: block;
  background: #eef1f5;
}

.request-item-page .preview-mask {
  position: absolute;
  inset: 0;
  background: rgba(17, 24, 39, 0.45);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.request-item-page .preview-badge {
  position: absolute;
  left: 12rpx;
  bottom: 12rpx;
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #ffffff;
  background: rgba(55, 65, 81, 0.85);
}

.request-item-page .preview-badge.phase-uploaded {
  background: rgba(29, 78, 216, 0.9);
}

.request-item-page .preview-badge.phase-confirmed {
  background: rgba(6, 95, 70, 0.9);
}

.request-item-page .preview-badge.phase-failed {
  background: rgba(185, 28, 28, 0.9);
}

.request-item-page .upload-phase-failed {
  background: #fef2f2;
  color: #b91c1c;
}

.request-item-page .upload-phase-confirmed {
  background: #ecfdf5;
  color: #065f46;
}

.request-item-page .meta-line {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #6b7280;
}

.request-item-page .upload-stage {
  margin-bottom: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: #eef4ff;
  color: #174ea6;
  font-size: 26rpx;
}

.footer-cta {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
