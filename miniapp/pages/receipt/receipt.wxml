<view class="container">
  <view class="card">
    <view class="status-pill done">{{status}}</view>
    <view class="card-title">{{title}}</view>
    <view class="card-subtitle">{{message}}</view>

    <view class="section-label">下一步</view>
    <view class="list-item">{{nextStep}}</view>

    <view class="section-label section-gap">照片</view>
    <view class="list-item">已上传 {{photoCount}} 张</view>

    <view class="disclaimer">{{disclaimer}}</view>
  </view>

  <view class="footer-cta">
    <button class="btn-primary" hover-class="btn-primary-hover" bindtap="onViewStatus">返回我的资料</button>
    <button
      wx:if="{{submitted}}"
      class="btn-secondary"
      hover-class="btn-secondary-hover"
      bindtap="onSupplement"
    >继续补充照片</button>
  </view>
</view>
