<view class="container">
  <task-shell
    loading="{{busy.loading}}"
    error="{{errorState}}"
    loadingMessage="{{loadingMessage}}"
    safetyCopy="{{shellSafetyCopy}}"
    showFooter="{{true}}"
    bind:retry="onRetry"
    bind:contactBroker="onContactBroker"
  >
    <task-error
      wx:if="{{errorState.message && !errorState.blocking}}"
      message="{{errorState.message}}"
      retryable="{{errorState.retryable}}"
      retryDisabled="{{busy.retrying}}"
      bind:retry="onRetry"
      bind:contactBroker="onContactBroker"
    />

    <view class="card">
      <view class="card-title">{{title}}</view>
      <view class="card-subtitle">{{message}}</view>
      <view class="list-item">{{nextStep}}</view>

      <view wx:if="{{showSupplement && materialsNote}}" class="section-label section-gap">还需您做</view>
      <view wx:if="{{showSupplement && materialsNote}}" class="list-item missing">{{materialsNote}}</view>

      <view wx:if="{{slice1Enabled && slice1ProgressText && showSupplement}}" class="list-item">{{slice1ProgressText}}</view>

      <view class="disclaimer">{{disclaimer}}</view>
    </view>
  </task-shell>

  <view class="footer-cta" wx:if="{{!busy.loading}}">
    <task-cta
      wx:if="{{submitted && showSupplement}}"
      label="{{slice1Enabled ? slice1PrimaryLabel : '补充或修改资料'}}"
      disabled="{{slice1Enabled ? (slice1WaitingForBroker || busy.navigating || busy.retrying || slice1LoadFailed) : (busy.navigating || busy.retrying)}}"
      loading="{{busy.navigating || busy.retrying}}"
      disabledReason="{{slice1LoadFailed ? (errorState.message || '一会儿再试，或联系陈总') : (slice1Enabled && slice1WaitingForBroker ? '陈总正在看，先不用操作' : ctaDisabledReason)}}"
      bindtap="onEditSupplementInfo"
    />
    <task-cta
      wx:elif="{{!submitted}}"
      label="返回我的报案"
      disabled="{{busy.navigating}}"
      loading="{{busy.navigating}}"
      disabledReason="{{ctaDisabledReason}}"
      bindtap="onViewStatus"
    />
    <button
      wx:if="{{submitted}}"
      class="btn-secondary"
      hover-class="btn-secondary-hover"
      bindtap="onViewAll"
      disabled="{{busy.navigating}}"
    >查看已提交内容</button>
    <button
      class="btn-secondary"
      hover-class="btn-secondary-hover"
      bindtap="onBackHome"
      disabled="{{busy.navigating}}"
    >返回首页</button>
  </view>
</view>
