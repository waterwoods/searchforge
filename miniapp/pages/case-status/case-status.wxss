.case-status-page .status-pill {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  background: #e8eef8;
  color: #1f4b99;
  font-size: 22rpx;
  margin-bottom: 16rpx;
}

.case-status-page .card-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #111827;
  line-height: 1.35;
  margin-bottom: 20rpx;
}

.case-status-page .body-block {
  margin-bottom: 8rpx;
}

.case-status-page .body-line {
  font-size: 28rpx;
  color: #374151;
  line-height: 1.55;
  margin-bottom: 8rpx;
}

.case-status-page .section-label {
  font-size: 24rpx;
  color: #6b7280;
  margin-bottom: 8rpx;
}

.case-status-page .section-gap {
  margin-top: 24rpx;
}

.case-status-page .list-item {
  font-size: 28rpx;
  color: #111827;
  line-height: 1.45;
  margin-bottom: 6rpx;
}

.case-status-page .case-trust-care {
  font-size: 26rpx;
  color: #374151;
  font-weight: 500;
}

.case-status-page .case-trust-note {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #6b7280;
}

.case-status-page .footer-cta {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 24rpx 32rpx 48rpx;
}

.case-status-page .btn-secondary {
  background: #ffffff;
  color: #1f4b99;
  border: 1rpx solid #c5d0e6;
  border-radius: 12rpx;
  font-size: 30rpx;
  padding: 22rpx 24rpx;
}

.case-status-page .btn-secondary-hover {
  background: #f3f6fb;
}
