<view class="container">
  <task-shell
    loading="{{busy.loading}}"
    error="{{errorState}}"
    loadingMessage="{{loadingMessage}}"
    safetyCopy="{{shellSafetyCopy}}"
    showFooter="{{true}}"
    bind:retry="onRetry"
    bind:contactBroker="onContactBroker"
  >
    <task-error
      wx:if="{{errorState.message && !errorState.blocking}}"
      message="{{errorState.message}}"
      retryable="{{errorState.retryable}}"
      retryDisabled="{{busy.retrying}}"
      bind:retry="onRetry"
      bind:contactBroker="onContactBroker"
    />

    <view class="card">
      <view class="card-title">补充事故照片</view>
      <view class="card-subtitle">
        先上传必需照片。上传后会自动回读服务器确认，已上传 {{photoCount}}/{{photoTarget}} 张。
      </view>
      <view wx:if="{{uploadStage}}" class="upload-stage" aria-live="polite">{{uploadStage}}</view>

      <task-photo
        slots="{{slots}}"
        disabled="{{busy.uploading}}"
        bind:add="onAddPhoto"
        bind:retry="onRetrySlot"
        bind:remove="onRemoveSlot"
        bind:preview="onPreviewSlot"
      />
    </view>
  </task-shell>

  <view class="footer-cta" wx:if="{{!busy.loading}}">
    <task-cta
      wx:if="{{photoCount < photoTarget}}"
      label="上传下一张"
      disabled="{{busy.uploading}}"
      loading="{{busy.uploading}}"
      bindtap="onAddPhoto"
    />
    <task-cta
      wx:else
      label="完成并返回我的资料"
      disabled="{{busy.uploading}}"
      loading="{{busy.uploading}}"
      bindtap="onDone"
    />
    <button
      class="btn-secondary"
      hover-class="btn-secondary-hover"
      bindtap="onBackHome"
      disabled="{{busy.uploading}}"
    >
      返回我的资料
    </button>
  </view>
</view>
