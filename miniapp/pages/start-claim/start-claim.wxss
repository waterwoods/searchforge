.start-claim-page .error-text {
  color: #c0392b;
  font-size: 28rpx;
  line-height: 1.5;
  margin-bottom: 16rpx;
}

.start-claim-page .init-error-block {
  margin-bottom: 24rpx;
  padding: 20rpx;
  background: #fef2f2;
  border-radius: 12rpx;
}

.start-claim-page .safety-footer {
  margin: 24rpx 32rpx 8rpx;
  font-size: 22rpx;
  color: #888;
  line-height: 1.5;
  text-align: center;
}

.start-claim-page .choice-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.start-claim-page .choice-btn {
  flex: 1 1 28%;
  min-width: 160rpx;
  padding: 16rpx 12rpx;
  font-size: 26rpx;
  line-height: 1.3;
  color: #0d3b66;
  background: #fff;
  border: 1px solid #0d3b66;
  border-radius: 12rpx;
}

.start-claim-page .choice-btn-active {
  background: #0d3b66;
  color: #fff;
}

.start-claim-page .choice-btn::after {
  border: none;
}

.start-claim-page .field-error {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #c0392b;
  line-height: 1.4;
}

.start-claim-page .field-invalid {
  border-color: #c0392b !important;
}

.start-claim-page .submit-hint {
  margin: 0 32rpx 12rpx;
  font-size: 24rpx;
  color: #666;
  line-height: 1.4;
  text-align: center;
}
