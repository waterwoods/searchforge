.start-claim-page .error-text {
  color: #c0392b;
  font-size: 28rpx;
  line-height: 1.5;
  margin-bottom: 16rpx;
}

.start-claim-page .init-error-block {
  margin-bottom: 24rpx;
  padding: 20rpx;
  background: #fef2f2;
  border-radius: 12rpx;
}

.start-claim-page .safety-footer {
  margin: 24rpx 32rpx 8rpx;
  font-size: 22rpx;
  color: #888;
  line-height: 1.5;
  text-align: center;
}

.start-claim-page .choice-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.start-claim-page .choice-btn {
  flex: 1 1 28%;
  min-width: 160rpx;
  padding: 16rpx 12rpx;
  font-size: 26rpx;
  line-height: 1.3;
  color: #0d3b66;
  background: #fff;
  border: 1px solid #0d3b66;
  border-radius: 12rpx;
}

.start-claim-page .choice-btn-active {
  background: #0d3b66;
  color: #fff;
}

.start-claim-page .choice-btn::after {
  border: none;
}

.start-claim-page .field-error {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #c0392b;
  line-height: 1.4;
}

.start-claim-page .field-invalid {
  border-color: #c0392b !important;
}

.start-claim-page .submit-hint {
  margin: 0 32rpx 12rpx;
  font-size: 24rpx;
  color: #666;
  line-height: 1.4;
  text-align: center;
}

.start-claim-page .why-ask {
  margin: -4rpx 0 10rpx;
  font-size: 22rpx;
  color: #718096;
  line-height: 1.4;
}

.start-claim-page .why-ask-photos {
  margin-top: 20rpx;
}

.start-claim-page .story-assist {
  margin-top: 16rpx;
  padding: 16rpx 18rpx;
  background: #f7fafc;
  border-left: 6rpx solid #4a5568;
}

.start-claim-page .story-assist-note {
  font-size: 22rpx;
  color: #718096;
  margin-bottom: 8rpx;
}

.start-claim-page .story-assist-summary {
  font-size: 26rpx;
  color: #2d3748;
  line-height: 1.45;
}

.start-claim-page .story-assist-q-title {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #4a5568;
  font-weight: 600;
}

.start-claim-page .story-assist-q {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #4a5568;
  line-height: 1.4;
}

.start-claim-page .guided-panel {
  margin-top: 20rpx;
  padding: 20rpx 18rpx;
  background: #f0f7fb;
  border-left: 6rpx solid #0d3b66;
}

.start-claim-page .guided-panel-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #0d3b66;
  margin-bottom: 4rpx;
}

.start-claim-page .guided-draft-label {
  font-size: 22rpx;
  color: #718096;
  margin-bottom: 12rpx;
}

.start-claim-page .guided-fact-row {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  padding: 6rpx 0;
  font-size: 26rpx;
  line-height: 1.4;
}

.start-claim-page .guided-fact-label {
  color: #4a5568;
  flex-shrink: 0;
}

.start-claim-page .guided-fact-value {
  color: #1a202c;
  text-align: right;
}

.start-claim-page .guided-fact-pending,
.start-claim-page .guided-fact-partial {
  color: #c05621;
}

.start-claim-page .guided-missing-msg {
  margin-top: 20rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #0d3b66;
}

.start-claim-page .guided-conflict {
  margin-top: 12rpx;
  padding: 12rpx 14rpx;
  background: #fffaf0;
  color: #9c4221;
  font-size: 24rpx;
  line-height: 1.4;
}

.start-claim-page .guided-full-link {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #2b6cb0;
  text-decoration: underline;
}

.start-claim-page .guided-confirm {
  margin-top: 8rpx;
}

.start-claim-page .guided-confirm-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #0d3b66;
  margin-bottom: 16rpx;
}

.start-claim-page .guided-confirm-block {
  margin-bottom: 14rpx;
}

.start-claim-page .guided-confirm-label {
  font-size: 22rpx;
  color: #718096;
  margin-bottom: 4rpx;
}

.start-claim-page .guided-confirm-text {
  font-size: 26rpx;
  color: #2d3748;
  line-height: 1.45;
}

.start-claim-page .guided-confirm-facts {
  margin: 12rpx 0 20rpx;
  font-size: 26rpx;
  color: #2d3748;
  line-height: 1.6;
}

.start-claim-page .guided-confirm-btn {
  margin-bottom: 12rpx;
}

.start-claim-page .guided-trust-note {
  margin: 8rpx 0 12rpx;
  font-size: 24rpx;
  color: #4a5568;
  line-height: 1.45;
}

.start-claim-page .guided-trust-note-fallback {
  color: #9c4221;
}

.start-claim-page .guided-confirm-secondary {
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: center;
  gap: 40rpx;
  padding: 8rpx 0 4rpx;
}

.start-claim-page .guided-confirm-link {
  font-size: 26rpx;
  color: #718096;
  text-decoration: underline;
  padding: 12rpx 8rpx;
  min-height: 44rpx;
  line-height: 1.4;
}

.start-claim-page .guided-confirm-link-hover {
  opacity: 0.7;
}

/* Voice-first Guided Intake V1 — large primary mic action */
.start-claim-page .voice-first-card {
  text-align: center;
  padding: 40rpx 32rpx 28rpx;
}

.start-claim-page .voice-first-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #0d3b66;
  line-height: 1.35;
  margin-bottom: 16rpx;
}

.start-claim-page .voice-first-status {
  font-size: 26rpx;
  color: #4a5568;
  line-height: 1.45;
  margin-bottom: 36rpx;
  min-height: 72rpx;
}

.start-claim-page .voice-first-mic-wrap {
  display: flex;
  justify-content: center;
  margin: 12rpx 0 20rpx;
}

.start-claim-page .voice-first-mic {
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: #0d3b66;
  color: #fff;
  font-size: 36rpx;
  font-weight: 600;
  line-height: 220rpx;
  padding: 0;
  margin: 0;
  border: none;
  box-shadow: 0 10rpx 28rpx rgba(13, 59, 102, 0.28);
}

.start-claim-page .voice-first-mic::after {
  border: none;
}

.start-claim-page .voice-first-mic-stop {
  background: #c05621;
  box-shadow: 0 10rpx 28rpx rgba(192, 86, 33, 0.28);
}

.start-claim-page .voice-first-mic-hover {
  opacity: 0.9;
}

.start-claim-page .voice-first-mic[disabled] {
  opacity: 0.55;
}

.start-claim-page .voice-first-mic-label {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a202c;
  margin-bottom: 28rpx;
}

.start-claim-page .voice-first-progress {
  font-size: 26rpx;
  color: #2b6cb0;
  margin-bottom: 24rpx;
}

.start-claim-page .voice-first-secondary {
  font-size: 28rpx;
  color: #2b6cb0;
  text-decoration: underline;
  padding: 16rpx 8rpx;
  margin-top: 8rpx;
}

.start-claim-page .voice-first-tertiary {
  font-size: 24rpx;
  color: #718096;
  text-decoration: underline;
  padding: 12rpx 8rpx;
  margin-bottom: 8rpx;
}

.start-claim-page .voice-first-link-hover {
  opacity: 0.7;
}
