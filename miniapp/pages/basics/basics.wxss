.radio-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.radio-chip {
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
  background: #f0f2f5;
  font-size: 26rpx;
  color: #444444;
}

.radio-chip.active {
  background: #e8f0fe;
  color: #1a56db;
  font-weight: 600;
}

.input-field {
  width: 100%;
  padding: 20rpx 24rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}
