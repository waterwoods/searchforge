<view class="container story-page">
  <task-shell
    loading="{{busy.loading}}"
    error="{{errorState}}"
    loadingMessage="{{loadingMessage}}"
    safetyCopy="{{shellSafetyCopy}}"
    showFooter="{{true}}"
    bind:retry="onRetry"
    bind:contactBroker="onContactBroker"
  >
    <task-error
      wx:if="{{errorState.message && !errorState.blocking}}"
      message="{{errorState.message}}"
      retryable="{{errorState.retryable}}"
      retryDisabled="{{busy.retrying}}"
      bind:retry="onRetry"
      bind:contactBroker="onContactBroker"
    />

    <view class="card">
      <view class="card-title">请简单说一下发生了什么</view>
      <view class="card-subtitle">{{cardSubtitle}}</view>
      <view class="voice-row">
        <button
          wx:if="{{showRecordBtn}}"
          class="voice-btn"
          hover-class="voice-btn-hover"
          disabled="{{recordBtnDisabled}}"
          bindtap="onTapRecord"
        >{{recordBtnLabel}}</button>
        <button
          wx:if="{{showStopBtn}}"
          class="voice-btn voice-btn-stop"
          hover-class="voice-btn-hover"
          bindtap="onTapStop"
        >停止</button>
        <view wx:if="{{voiceHint}}" class="voice-hint">{{voiceHint}}</view>
      </view>
      <textarea
        class="textarea-field"
        placeholder="请描述事故经过…"
        maxlength="2000"
        value="{{story}}"
        bindinput="onInput"
        auto-height
        show-confirm-bar="{{false}}"
        disabled="{{busy.saving || storyInputDisabled}}"
      />
      <view class="char-count">{{charCount}} 字</view>
    </view>
  </task-shell>

  <view class="footer-cta" wx:if="{{!busy.loading}}">
    <task-cta
      label="保存并返回我的资料"
      disabled="{{busy.saving || confirmDisabled}}"
      loading="{{busy.saving}}"
      bindtap="onSave"
    />
    <button class="btn-secondary" hover-class="btn-secondary-hover" bindtap="onLater">稍后再填</button>
  </view>
</view>
