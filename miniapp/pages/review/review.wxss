.muted-text {
  color: #888888;
}

.review-ready {
  margin: 8rpx 0 4rpx;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 1.45;
}

.review-ready.ok {
  background: #e6f4ea;
  color: #137333;
}

.review-ready.need {
  background: #fef3e8;
  color: #b45f06;
}

.missing-list {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.list-item.missing.actionable {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 8rpx;
  border-radius: 12rpx;
}

.missing-row-hover {
  background: #fef3e8;
}

.missing-label {
  flex: 1;
}

.missing-arrow {
  margin-left: 16rpx;
  color: #c45c26;
  font-size: 36rpx;
  line-height: 1;
}
