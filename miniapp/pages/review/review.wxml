<view class="container">
  <view class="card">
    <view class="card-title">请检查事故资料</view>
    <view class="card-subtitle">确认无误后提交给陈总审核。</view>

    <view class="section-label">事故经过</view>
    <view class="review-block {{story ? '' : 'empty'}}">{{story || '未填写'}}</view>

    <view class="section-label section-gap">照片</view>
    <view class="list-item">已上传 {{photoCount}} 张</view>

    <view class="section-label section-gap">已收到</view>
    <view wx:if="{{received.length}}">
      <view class="list-item" wx:for="{{received}}" wx:key="*this">{{item}}</view>
    </view>
    <view wx:else class="list-item muted-text">暂无</view>

    <view class="section-label section-gap">还需补充</view>
    <view wx:if="{{missing.length}}">
      <view class="list-item missing" wx:for="{{missing}}" wx:key="*this">{{item}}</view>
    </view>
    <view wx:else class="list-item muted-text">主要资料已齐全</view>

    <view class="disclaimer">{{disclaimer}}</view>
  </view>

  <view class="footer-cta">
    <button
      class="btn-primary"
      hover-class="btn-primary-hover"
      bindtap="onSubmit"
      loading="{{submitting}}"
      disabled="{{submitting || !canSubmit}}"
    >提交给陈总审核</button>
    <button class="btn-secondary" hover-class="btn-secondary-hover" bindtap="onEditStory">修改事故经过</button>
    <button class="btn-secondary" hover-class="btn-secondary-hover" bindtap="onEditBasics">修改基本资料</button>
    <button class="btn-secondary" hover-class="btn-secondary-hover" bindtap="onEditPhotos">补充照片</button>
  </view>
</view>
