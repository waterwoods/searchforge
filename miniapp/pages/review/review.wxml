<view class="container">
  <task-shell
    loading="{{busy.loading}}"
    error="{{errorState}}"
    loadingMessage="{{loadingMessage}}"
    safetyCopy="{{shellSafetyCopy}}"
    showFooter="{{true}}"
    bind:retry="onRetry"
    bind:contactBroker="onContactBroker"
  >
    <task-error
      wx:if="{{errorState.message && !errorState.blocking}}"
      message="{{errorState.message}}"
      retryable="{{errorState.retryable}}"
      retryDisabled="{{busy.retrying || busy.submitting}}"
      bind:retry="onRetry"
      bind:contactBroker="onContactBroker"
    />

    <view class="card">
      <view class="card-title">请确认资料</view>
      <view class="card-subtitle">{{readyLabel}}</view>

      <view class="review-ready {{canSubmit ? 'ok' : 'need'}}">{{readySummary}}</view>

      <view wx:if="{{missingRows.length}}" class="section-label section-gap">还需补充</view>
      <view wx:if="{{missingRows.length}}" class="missing-list">
        <view
          wx:for="{{missingRows}}"
          wx:key="key"
          class="list-item missing {{item.actionable ? 'actionable' : ''}}"
          hover-class="{{item.actionable ? 'missing-row-hover' : ''}}"
          data-index="{{index}}"
          bindtap="onTapMissingRow"
        >
          <text class="missing-label">{{item.label}}</text>
          <text wx:if="{{item.actionable}}" class="missing-arrow">›</text>
        </view>
      </view>

      <view class="section-label section-gap">资料概要</view>
      <view class="list-item">事故经过：{{storyPreview}}</view>
      <view class="list-item">事故照片：已上传 {{photoCount}} 张</view>

      <view class="disclaimer">{{disclaimer}}</view>
    </view>
  </task-shell>

  <view class="footer-cta" wx:if="{{!busy.loading}}">
    <task-cta
      label="确认并交给陈总"
      disabled="{{!canSubmit || busy.submitting || busy.navigating}}"
      loading="{{busy.submitting}}"
      disabledReason="{{submitDisabledReason}}"
      bindtap="onSubmit"
    />
    <button
      wx:if="{{showSupplementCta}}"
      class="btn-secondary"
      hover-class="btn-secondary-hover"
      bindtap="onSupplement"
      disabled="{{busy.submitting || busy.navigating}}"
    >{{supplementCtaLabel}}</button>
    <button
      class="btn-secondary"
      hover-class="btn-secondary-hover"
      bindtap="onLater"
      disabled="{{busy.submitting}}"
    >返回我的报案</button>
  </view>
</view>
