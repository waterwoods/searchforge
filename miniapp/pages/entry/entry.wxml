<view class="container">
  <view wx:if="{{loading}}" class="loading-wrap">
    <text>正在打开你的事故资料…</text>
  </view>

  <view wx:else class="card">
    <view class="card-title">无法打开任务</view>
    <view class="card-subtitle">{{errorMessage}}</view>
    <button class="btn-primary" bindtap="onRetry">重试</button>
    <button class="btn-secondary" bindtap="onContactBroker">返回微信联系陈总</button>
  </view>
</view>
