page {
  background-color: #f5f6f8;
  color: #1a1a1a;
  font-size: 30rpx;
  line-height: 1.5;
  box-sizing: border-box;
}

.section-gap {
  margin-top: 28rpx;
}

.container {
  min-height: 100vh;
  padding: 32rpx 32rpx 300rpx;
}

.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.card-subtitle {
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 24rpx;
}

.section-label {
  font-size: 28rpx;
  color: #374151;
  font-weight: 600;
  margin-bottom: 12rpx;
  text-transform: none;
}

.list-item {
  font-size: 28rpx;
  padding: 8rpx 0;
  color: #333333;
}

.list-item.missing {
  color: #c45c26;
}

.status-pill {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  background: #e8f0fe;
  color: #1a56db;
  margin-bottom: 16rpx;
}

.status-pill.done {
  background: #e6f4ea;
  color: #137333;
}

.progress-bar {
  height: 8rpx;
  background: #e8eaed;
  border-radius: 4rpx;
  overflow: hidden;
  margin: 16rpx 0 24rpx;
}

.progress-fill {
  height: 100%;
  background: #1a56db;
  border-radius: 4rpx;
  transition: width 0.2s ease;
}

.footer-cta {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(245, 246, 248, 0) 0%, #f5f6f8 24%, #f5f6f8 100%);
}

.btn-primary {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: #1a56db;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 16rpx;
  border: none;
  text-align: center;
}

.btn-primary::after {
  border: none;
}

.btn-primary-hover {
  background: #1648b8 !important;
  opacity: 0.92;
}

.btn-primary[loading],
.btn-primary[disabled] {
  background: #a8c4f0;
  color: #ffffff;
}

.btn-secondary {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: transparent;
  color: #1a56db;
  font-size: 28rpx;
  border: none;
  text-align: center;
  margin-top: 8rpx;
}

.btn-secondary::after {
  border: none;
}

.btn-secondary-hover {
  opacity: 0.7;
}

.radio-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.radio-chip {
  padding: 16rpx 28rpx;
  border-radius: 12rpx;
  background: #f0f2f5;
  font-size: 28rpx;
  color: #444444;
}

.radio-chip.active {
  background: #e8f0fe;
  color: #1a56db;
  font-weight: 600;
}

.radio-chip-hover {
  background: #e4e8ee;
}

.input-field {
  width: 100%;
  min-height: 96rpx;
  padding: 20rpx 24rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  color: #111827;
  font-size: 32rpx;
  line-height: 1.5;
  box-sizing: border-box;
}

.placeholder-muted {
  color: #6b7280;
  font-size: 30rpx;
}

.review-block {
  background: #f8f9fa;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  white-space: pre-wrap;
  line-height: 1.6;
  font-size: 28rpx;
  color: #333333;
}

.review-block.empty {
  color: #888888;
}

.disclaimer {
  font-size: 22rpx;
  color: #888888;
  line-height: 1.6;
  margin-top: 24rpx;
}

.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
  color: #666666;
  gap: 24rpx;
}

.loading-text {
  font-size: 28rpx;
  color: #666666;
}

.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.photo-slot {
  width: 300rpx;
  height: 300rpx;
  border-radius: 16rpx;
  background: #eef0f3;
  overflow: hidden;
  position: relative;
}

.photo-slot image {
  width: 100%;
  height: 100%;
}

.photo-slot.empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #888888;
  font-size: 26rpx;
  border: 2rpx dashed #c4c8cc;
}

.photo-remove {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 48rpx;
  height: 48rpx;
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
  border-radius: 50%;
  text-align: center;
  line-height: 48rpx;
  font-size: 28rpx;
}

.textarea-field {
  width: 100%;
  min-height: 280rpx;
  padding: 24rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
  color: #111827;
  font-size: 30rpx;
  line-height: 1.6;
  box-sizing: border-box;
}

.compact-textarea {
  min-height: 152rpx;
}

.char-count {
  text-align: right;
  font-size: 24rpx;
  color: #888888;
  margin-top: 8rpx;
}

/* Shared Voice Story controls — Start Claim + Story */
.voice-row {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  margin: 4rpx 0 20rpx;
  gap: 14rpx;
}

.voice-btn {
  width: 260rpx !important;
  min-height: 88rpx !important;
  height: 88rpx !important;
  line-height: 88rpx !important;
  margin: 0 !important;
  padding: 0 32rpx !important;
  border-radius: 16rpx !important;
  border: 2rpx solid #1a56db !important;
  background: #e8f0fe !important;
  color: #1a56db !important;
  font-size: 28rpx !important;
  font-weight: 600 !important;
  text-align: center;
  box-sizing: border-box !important;
}

.voice-btn::after {
  border: none;
}

.voice-btn-stop {
  border-color: #f04438 !important;
  background: #fef3f2 !important;
  color: #b42318 !important;
}

.voice-btn-hover {
  opacity: 0.88;
}

.voice-btn[disabled] {
  opacity: 0.45;
}

.voice-hint {
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.45;
  max-width: 100%;
}
