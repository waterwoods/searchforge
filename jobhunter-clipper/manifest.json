{
  "manifest_version": 3,
  "name": "JobHunter Clipper",
  "description": "Clip job postings (URL, title, JD text) into local storage for JobHunter Agent",
  "version": "0.1.0",
  "action": {
    "default_popup": "popup.html",
    "default_title": "JobHunter Clipper"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}