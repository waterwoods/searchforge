# Environment Variables for Cloud Run Deployment
# Copy this file to .env.cloudrun and fill real values. NEVER commit .env.cloudrun.
#
# --- Runtime authority (single source of truth, anti-drift) ---
# - Backend container env on FULL deploy: whatever `bash scripts/deploy_rag_demo.sh` sends via
#   `--set-env-vars` from THIS file (`.env.cloudrun`). That bundle replaces those keys on Cloud Run;
#   manual `gcloud run services update` patches are lost on the next full deploy unless mirrored here.
# - Frontend API target: Vercel Project → Environment Variables → `VITE_API_BASE_URL` (baked at build).
#   After deploy: `gcloud run services describe fiqa-api --region us-west1 --format='value(status.url)'`
#   must match that value (Google may show `*.a.run.app` while Vercel embeds `*-PROJECT.REGION.run.app` — same service if both hit `/health/live`).
# - Browser CORS: Cloud Run `ALLOWED_ORIGINS` must list every real page Origin (alias + per-deploy
#   `ui-*.vercel.app` links). Mismatch → empty workbench / Network Error with no API500.
#
# Usage:
#   cp configs/demo.env.example .env.cloudrun
#   # Edit .env.cloudrun with your values (see "HUMAN CONFIRMATION" below)
#   bash scripts/deploy_rag_demo.sh
#
# REQUIRED for demo: QDRANT_URL, QDRANT_API_KEY (if Qdrant Cloud), QDRANT_COLLECTION
# REQUIRED for LLM triage: OPENAI_API_KEY
# REQUIRED for Vercel CORS: ALLOWED_ORIGINS (when frontend on Vercel)
#
# HUMAN CONFIRMATION REQUIRED (do not invent; fill from your dashboards):
#   QDRANT_URL, QDRANT_API_KEY  → Qdrant Cloud dashboard
#   OPENAI_API_KEY              → OpenAI dashboard
#   ALLOWED_ORIGINS             → Your Vercel URL(s) after frontend deploy

# ========================================
# Required: Qdrant Connection
# ========================================
# External Qdrant instance URL (REQUIRED)
# Examples:
#   - Qdrant Cloud: https://your-cluster-id.us-east4-0.gcp.cloud.qdrant.io
#   - Self-hosted: http://1.2.3.4:6333
#   - Local development: http://localhost:6333
#   - Cloud Run Qdrant: https://qdrant-service-xxx.run.app
QDRANT_URL=https://your-qdrant-instance.com:6333

# Qdrant API Key (REQUIRED for Qdrant Cloud, optional for self-hosted)
# For Qdrant Cloud, get your API key from the Qdrant Cloud dashboard
# Example: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Leave empty only if using unauthenticated self-hosted Qdrant
QDRANT_API_KEY=

# Qdrant collection name
# - fiqa_10k_v1: generic RAG demo
# - auto_insurance_demo_core: Unified Intake / broker demo (notice retrieval, DMV/SR-22)
QDRANT_COLLECTION=auto_insurance_demo_core

# ========================================
# Qdrant Cloud Setup (Optional)
# ========================================
# To use Qdrant Cloud:
# 1. Get your cluster URL and API key from Qdrant Cloud dashboard
# 2. Set QDRANT_URL to your cluster URL (no port needed, e.g., https://xxx.us-east4-0.gcp.cloud.qdrant.io)
# 3. Set QDRANT_API_KEY to your API key
# 4. Verify connection: python scripts/verify_qdrant_cloud.py
# 5. Migrate local collection: python scripts/migrate_local_qdrant_to_cloud.py --cloud-url $QDRANT_URL --cloud-api-key $QDRANT_API_KEY

# ========================================
# Optional: GCP Project Overrides
# ========================================
# Override default project (default: optimal-disk-472305-e2)
# PROJECT_ID=your-project-id

# Override default region (default: us-west1)
# REGION=us-central1

# ========================================
# Cloud Run container sizing (deploy_rag_demo.sh)
# ========================================
# Proven-good live defaults (fiqa-api / us-west1) — override only with intent.
# CLOUD_RUN_MEMORY=1Gi
# CLOUD_RUN_CONCURRENCY=30
# Pilot/demo: set to 1 to keep one warm instance (higher baseline cost; avoids idle cold start).
# Rollback: 0 or omit (deploy script default). Same effect without redeploy: gcloud run services update fiqa-api --region us-west1 --min-instances 0
# CLOUD_RUN_MIN_INSTANCES=0
# CLOUD_RUN_MAX_INSTANCES=2

# ========================================
# Cloud Run: Secret Manager (recommended for production)
# ========================================
# When OPENAI / Qdrant / DB URL are stored in Google Secret Manager, set:
#   CLOUD_RUN_USE_SECRET_MANAGER=1
# so scripts/deploy_rag_demo.sh uses --set-secrets (default secret names: fiqa-openai-api-key,
# fiqa-qdrant-api-key, fiqa-service-record-database-url). You may keep local-only copies in
# .env.cloudrun for preflight Qdrant checks, or skip preflight when the key is GSM-only.
# CLOUD_RUN_USE_SECRET_MANAGER=1
#
# If the live Cloud Run service already binds OPENAI_API_KEY / QDRANT_API_KEY / SERVICE_RECORD_DATABASE_URL
# via Secret Manager, you MUST deploy with CLOUD_RUN_USE_SECRET_MANAGER=1 (or prefix the deploy command);
# otherwise gcloud fails when trying to replace a secret-backed var with a plaintext literal.

# ========================================
# Required for Unified Intake (LLM triage)
# ========================================
# OpenAI API Key — REQUIRED for inbox triage LLM (use Secret Manager in production)
# Without it, triage falls back to rule-based only.
OPENAI_API_KEY=

# Enable LLM generation — set to 1 when OPENAI_API_KEY is set for full triage quality
# LLM_GENERATION_ENABLED=1

# ========================================
# V6 Automatic Input (OCR) — optional
# ========================================
# Google Vision REST (images:annotate): set one of these API keys, or use GOOGLE_APPLICATION_CREDENTIALS + SDK.
# GOOGLE_API_KEY=
# GOOGLE_CLOUD_API_KEY=
# Client-pack override: ui_copy.v6_auto_input_variant (A | B | C) or:
# V6_AUTO_INPUT_VARIANT=B
# Force empty OCR (tests / no billing): V6_OCR_FORCE_STUB=1
# Dev stub text when no Vision: V6_OCR_STUB_TEXT="VIN 1HGCM82633A004352 ZIP 92602"

# --- Add-Car pilot parity (keep LOCAL / STAGING / PROD identical for these three) ---
# Post-truth Assist on /api/inbox/triage (LLM). Pilot: enable in all environments that promise Assist in UX.
ENABLE_ASSIST_LAYER=1
# Extra truth_guardrail_debug arrays on triage JSON. Pilot: 0 everywhere unless actively debugging guardrails.
DEBUG_TRUTH_GUARDRAILS=0
# Unknown collected/still_needed field ids: warn (default) or raise if 1.
ADD_CAR_CONTRACT_STRICT=0
# Optional override; defaults to LLM_MODEL or gpt-4o-mini
# ASSIST_LAYER_MODEL=gpt-4o-mini

# ========================================
# Required for Vercel frontend (CORS)
# ========================================
# CORS origins — Set when frontend is on Vercel. Comma-separated, no spaces, no trailing slashes.
# CRITICAL (deploy drift): `bash scripts/deploy_rag_demo.sh` passes --set-env-vars built from THIS file.
# The next full backend deploy REPLACES Cloud Run env with that bundle — any manual `gcloud run services update`
# tweaks to ALLOWED_ORIGINS are lost unless the same list lives here (or you re-patch after deploy).
#
# Founder-facing canonical UI URL (bookmark this): https://ui-smoky-beta.vercel.app/workbench/unified-intake
# Also allow the production deployment hostname Vercel prints (`ui-*.vercel.app`) and `ui-git-main-*.vercel.app`
# if anyone opens those links — browser Origin is the page URL, not the alias.
#
# Example (replace with your live deployment URLs after `cd ui && vercel ls`):
# ALLOWED_ORIGINS=https://ui-smoky-beta.vercel.app,https://ui-XXXXXXXX-andys-projects-1f411b73.vercel.app,https://ui-git-main-andys-projects-1f411b73.vercel.app
#
# Live pilot reference (verify with `gcloud run services describe fiqa-api --region us-west1 --format=json` → env ALLOWED_ORIGINS):
# https://ui-smoky-beta.vercel.app,https://ui-ow4ovsfz4-andys-projects-1f411b73.vercel.app,https://ui-1qr8rzs2a-andys-projects-1f411b73.vercel.app,https://ui-git-main-andys-projects-1f411b73.vercel.app
#
# If unset/empty in .env.cloudrun: deploy omits ALLOWED_ORIGINS → Cloud Run drops it → app falls back to permissive demo CORS.
# For locked-down production, always set an explicit list here before deploying.
# ALLOWED_ORIGINS=*  (allows any origin; use only for lightweight demo)
# ALLOWED_ORIGINS=

# ========================================
# Readiness (deploy script sets DEMO_MODE=true)
# ========================================
# DEMO_MODE=true — Makes Qdrant/embedding optional for /readyz. Intake path (triage) works without them.
# Deploy script sets this automatically. /readyz returns ok=true and intake_path_ready=true when DEMO_MODE=true.

# ========================================
# Optional: Postgres mirror for Add-Car Stage-1 service records (pilot parity)
# ========================================
# When both are set, deploy_rag_demo.sh passes them to Cloud Run so dual-write runs there too.
# Requires: schema applied (scripts/apply_stage1_service_record_schema.sh) on the target DB.
# Stage-1 mirror: any standard Postgres URL works (e.g. Neon / Supabase / Railway — low baseline vs Cloud SQL).
# SECURITY: connection strings in Cloud Run env are visible to project operators; use Secret Manager for production.
# SERVICE_RECORD_DATABASE_URL=postgresql://USER:PASS@HOST:5432/DBNAME
# UNIFIED_INTAKE_PG_DUAL_WRITE=1
# Proven-good strict DB-primary pilot (live): reads + writes from Postgres; JSON case file off; JSON read fallback off.
# UNIFIED_INTAKE_DB_PRIMARY_READS=1
# UNIFIED_INTAKE_DB_PRIMARY_WRITES=1
# UNIFIED_INTAKE_JSON_CASE_WRITES=0
# UNIFIED_INTAKE_JSON_READ_FALLBACK=0
# If you must serve stale JSON when PG misses a row (debug only), set UNIFIED_INTAKE_JSON_READ_FALLBACK=1

# ========================================
# Optional: Unified Intake Storage (demo/prod isolation)
# ========================================
# In-progress sessions: Postgres table `intake_sessions` when SERVICE_RECORD_DATABASE_URL
# or DATABASE_URL is set (see services/fiqa_api/db/schema/intake_sessions.sql).
# Without a DB URL, sessions do not persist unless you explicitly enable the in-process
# store (tests / one-off scripts only — not production):
# UNIFIED_INTAKE_ALLOW_INMEMORY_SESSIONS_FOR_TESTS=1
# Case JSON path (if not using DB-primary case writes):
# UNIFIED_INTAKE_CASES_PATH=data/demo_cases.json

# ========================================
# Optional: Observability
# ========================================
# Enable Langfuse observability
# OBS_ENABLED=0
# LANGFUSE_SECRET_KEY=sk-...
# LANGFUSE_PUBLIC_KEY=pk-...
# LANGFUSE_HOST=https://cloud.langfuse.com

# ========================================
# Optional: WeChat optional binding (client-pack light_identity.wechat_binding_mode: live)
# ========================================
# OAuth: register this exact redirect URI in the WeChat app (must match bytes-for-bytes):
#   {WECHAT_BINDING_REDIRECT_URI}
#   or if unset: {PUBLIC_API_BASE_URL}/api/inbox/wechat/binding/callback
# Staging checklist: HTTPS Cloud Run URL; same string in WeChat dashboard and env.
# Do not commit real secrets; use Secret Manager / env injection in production.
# WECHAT_APP_ID=
# WECHAT_APP_SECRET=
# WECHAT_BINDING_REDIRECT_URI=https://your-api.run.app/api/inbox/wechat/binding/callback
# PUBLIC_API_BASE_URL=https://your-api.run.app
# API_PUBLIC_URL=https://your-api.run.app
#   (alias read by wechat_binding.build_redirect_uri if PUBLIC_API_BASE_URL unset)
# UNIFIED_INTAKE_FRONTEND_ORIGIN=https://your-app.vercel.app
# WECHAT_BINDING_PEPPER=long-random-pepper-for-person_link_key
# WECHAT_BINDING_STATE_SECRET=long-random-secret-for-oauth-state
# Dev/staging only: complete binding without WeChat (never enable in production)
# WECHAT_BINDING_ALLOW_SIMULATE=0
# Optional: default client pack when UI omits ?client= (pilot: socal_precision for live WeChat)
# CLIENT_ID=socal_precision
