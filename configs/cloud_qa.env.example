# Cloud QA (P36) — environment template
# Copy to repo-root .env.cloudrun.qa and fill real values. NEVER commit .env.cloudrun.qa.
#
# Canonical names SSOT: docs/runbooks/CLOUD_QA_RESOURCE_NAMES.md
#
#   cp configs/cloud_qa.env.example .env.cloudrun.qa
#
# DO NOT use this file for Production.
# DO NOT copy these names into .env.cloudrun.
# Production template remains: configs/demo.env.example → .env.cloudrun
#
# ═══════════════════════════════════════════════════════════════════════════════
# FROZEN RESOURCE NAMES (P36 T1) — do not improvise
# ═══════════════════════════════════════════════════════════════════════════════
# Cloud Run service:     fiqa-api-qa          (Production: fiqa-api)
# Postgres database:     caseiq-qa            (Production: caseiq)
# Cloud SQL instance:    caseiq-pilot-pg      (same instance OK; different DB required)
# DB Secret Manager:     fiqa-service-record-database-url-qa
#                        (Production: fiqa-service-record-database-url-cloudsql-private)
# Operator env file:     .env.cloudrun.qa     (Production: .env.cloudrun)
# GCP project / region:  optimal-disk-472305-e2 / us-west1
# ═══════════════════════════════════════════════════════════════════════════════

# --- Identity (must match frozen names) ---
SERVICE_NAME=fiqa-api-qa
PROJECT_ID=optimal-disk-472305-e2
REGION=us-west1

# --- Cloud Run Secret Manager bindings ---
CLOUD_RUN_USE_SECRET_MANAGER=1
# REQUIRED distinct from Production:
CLOUD_RUN_SECRET_SERVICE_RECORD_DB=fiqa-service-record-database-url-qa
# Non-DB secrets may reuse Production names until a later task requires separation:
# CLOUD_RUN_SECRET_OPENAI=fiqa-openai-api-key
# CLOUD_RUN_SECRET_QDRANT=fiqa-qdrant-api-key
# CLOUD_RUN_SECRET_H5_TASK_TOKEN=fiqa-h5-task-token-secret

# --- Runtime posture (Cloud QA — fill when wiring deploy; not applied by T1) ---
# ENV=qa
# UNIFIED_INTAKE_PRODUCT_ONLY=1
# UNIFIED_INTAKE_INTAKE_CORE_READINESS=1
# UNIFIED_INTAKE_DB_PRIMARY_READS=1
# UNIFIED_INTAKE_DB_PRIMARY_WRITES=1
# UNIFIED_INTAKE_JSON_CASE_WRITES=0
# UNIFIED_INTAKE_JSON_READ_FALLBACK=0
# UNIFIED_INTAKE_PG_DUAL_WRITE=0

# Founder QA / harness flags belong on Cloud QA only (never on Production fiqa-api):
# ENABLE_P35_MP_QA_HARNESS=1
# UNIFIED_INTAKE_QA_FIXTURE_SURFACE=1
# P20_SLICE1_REQUEST_MORE=1

# --- Keys / CORS (fill locally; prefer Secret Manager on Cloud Run) ---
# UNIFIED_INTAKE_INTAKE_API_KEY=
# UNIFIED_INTAKE_SUPPORT_API_KEY=
# OPENAI_API_KEY=
# ALLOWED_ORIGINS=https://your-qa-ui.vercel.app

# --- Optional plaintext DB URL for laptop inspect only (never commit) ---
# Must target database caseiq-qa — never caseiq.
# SERVICE_RECORD_DATABASE_URL=postgresql://USER:PASS@HOST:5432/caseiq-qa
