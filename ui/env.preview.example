# Vercel Preview / Founder QA — environment template (P36 T5)
# Set these in Vercel → Project → Settings → Environment Variables → Preview.
# Do NOT apply these values to the Production environment.
#
# Frozen Cloud QA API (fiqa-api-qa):
VITE_API_BASE_URL=https://fiqa-api-qa-g7zatxrycq-uw.a.run.app
#
# Optional Founder QA UI surface (Preview only):
# VITE_ENABLE_QA_TOOLS=1
#
# Intake API key must match UNIFIED_INTAKE_INTAKE_API_KEY on fiqa-api-qa
# (set in Vercel Preview secrets; never commit the value):
# VITE_UNIFIED_INTAKE_INTAKE_API_KEY=
#
# Production environment must remain:
#   VITE_API_BASE_URL=https://fiqa-api-g7zatxrycq-uw.a.run.app
#
# Operator commands (Preview only — does not touch Production):
#   cd ui
#   vercel env add VITE_API_BASE_URL preview
#   # paste: https://fiqa-api-qa-g7zatxrycq-uw.a.run.app
#   vercel env add VITE_UNIFIED_INTAKE_INTAKE_API_KEY preview
#   # paste QA intake key from .env.cloudrun.qa (not Production key)
#   vercel env add VITE_ENABLE_QA_TOOLS preview
#   # paste: 1
#   vercel --yes   # redeploy Preview; do NOT use --prod
#
